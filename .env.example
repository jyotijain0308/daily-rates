POSTGRES_DB=ppt_daily_rates
POSTGRES_USER=ppt_user
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql+psycopg://ppt_user:replace-with-a-strong-password@host.docker.internal:5432/ppt_daily_rates
HOST_DATABASE_URL=postgresql+psycopg://ppt_user:replace-with-a-strong-password@127.0.0.1:5432/ppt_daily_rates
APP_PORT=8000
SECRET_KEY=replace-with-a-random-secret
OPENAI_API_KEY=
PDF_TABLE_EXTRACTION_PROVIDER=ollama
OPENAI_PDF_EXTRACTION_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_PDF_EXTRACTION_MODEL=llama3.2-vision
HASHTAG_OLLAMA_MODEL=llama3.2
PRODUCT_IMAGE_AUTO_FETCH=true
PRODUCT_IMAGE_PREFETCH_ON_GENERATE=true
PRODUCT_IMAGE_PREFETCH_LIMIT=20
PRODUCT_IMAGE_FETCH_TIMEOUT_SECONDS=5

# Optional fallback/bootstrap values. Prefer managing social app keys from
# Company -> Social App Keys after the app is running.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/social/youtube/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/social/facebook/callback
FACEBOOK_GRAPH_VERSION=v23.0
FACEBOOK_LOGIN_CONFIG_ID=
FACEBOOK_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,business_management,instagram_basic,instagram_content_publish
SOCIAL_PUBLIC_BASE_URL=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/api/social/x/callback
X_SCOPES="tweet.read tweet.write users.read media.write offline.access"
X_MEDIA_CATEGORY=tweet_video
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/social/linkedin/callback
LINKEDIN_PERSONAL_SCOPES="openid profile w_member_social"
LINKEDIN_PAGE_SCOPES="openid profile rw_organization_admin w_organization_social"
LINKEDIN_PROMPT=login
